# Momentum runs with NO environment variables. Everything below is optional and only for
# future integrations. Never commit a real .env file; never put server secrets in the app.
#
# Values prefixed EXPO_PUBLIC_ are embedded in the app bundle and are visible to anyone
# who has the app. Only put public, non-secret values there.

# Optional: point a future Firebase adapter at the LOCAL emulators (no real project needed).
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-momentum
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# MOCK webhook secret used only by local tests / the simulated payment provider.
# It is not a real credential. A real provider secret would live ONLY on a server.
MOCK_WEBHOOK_SECRET=whsec_mock_local_demo_only
