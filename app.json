{
  "expo": {
    "name": "Momentum",
    "slug": "momentum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.momentum.demo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3E5C4E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.momentum.demo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "momentum",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3E5C4E"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3E5C4E"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
